PORT=4000

# Local PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pmo_pilot

# Secret used to sign admin login tokens. Set this to a long random string
# before deploying anywhere — the server falls back to an insecure default
# (with a warning) if it's unset, which is fine for local dev only.
JWT_SECRET=

# Password for the single admin account created by `npm run seed`. Defaults
# to "sitpmo-admin" if unset — change this before deploying anywhere.
ADMIN_SEED_PASSWORD=

# Password for every seeded stakeholder account, PMO officers (john.tan,
# kevin.ng) included. Defaults to "password" if unset.
USER_SEED_PASSWORD=

# Optional: real SMTP settings for actually sending .ics meeting invites.
# Leave all of these unset to use a safe local-only mode (nothing is sent
# over the network; the server just reports what *would* have been sent).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PMO Pilot <noreply@example.com>"
